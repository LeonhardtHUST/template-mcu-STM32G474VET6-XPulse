{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "STM32CubeMX: Open .ioc",
      "type": "shell",
      "windows": {
        "command": "STM32CubeMX.exe",
        "args": ["${workspaceFolder}\\template-mcu-STM32G474VET6-XPulse.ioc"]
      },
      "linux": {
        "command": "STM32CubeMX",
        "args": ["${workspaceFolder}/template-mcu-STM32G474VET6-XPulse.ioc"]
      },
      "problemMatcher": []
    },
    {
      "label": "PlatformIO: Build",
      "type": "PlatformIO",
      "task": "Build",
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "PlatformIO: Upload",
      "type": "PlatformIO",
      "task": "Upload",
      "problemMatcher": ["$gcc"]
    }
  ]
}
