{
  "files.exclude": {
    "**/.pio": true
  },
  "search.exclude": {
    "**/.pio": true
  },
  "files.associations": {
    "*.ioc": "ini"
  },
  // 语义分析统一由 clangd 负责（见 compile_commands.json / .clangd），
  // 下面这几项把 cpptools 彻底静音，避免两套诊断打架并省内存。
  // 注意：cpptools 是 platformio-ide 的硬依赖，不能卸载，只能让它不干活。
  "C_Cpp.intelliSenseEngine": "disabled",
  "C_Cpp.intelliSenseEngineFallback": "disabled",
  "C_Cpp.autocomplete": "disabled",
  "C_Cpp.errorSquiggles": "disabled",
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}",
    "--query-driver=**/arm-none-eabi-gcc,**/arm-none-eabi-g++,**/arm-none-eabi-gcc.exe,**/arm-none-eabi-g++.exe",
    "--background-index",
    "--clang-tidy"
  ],
  "clangd.restartAfterCrash": true
}
