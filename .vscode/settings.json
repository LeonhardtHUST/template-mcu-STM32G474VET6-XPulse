{
  "files.exclude": {
    "**/.pio": true
  },
  "search.exclude": {
    "**/.pio": true
  },
  "files.associations": {
    "*.ioc": "ini"
  },
  "C_Cpp.intelliSenseEngine": "disabled",
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}",
    "--query-driver=**/arm-none-eabi-gcc,**/arm-none-eabi-g++,**/arm-none-eabi-gcc.exe,**/arm-none-eabi-g++.exe",
    "--background-index",
    "--clang-tidy"
  ],
  "clangd.restartAfterCrash": true
}
